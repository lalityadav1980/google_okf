{
  "$defs": {
    "ProfileReference": {
      "additionalProperties": false,
      "properties": {
        "okf_version": {
          "title": "Okf Version",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "title": "Profile Version",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "okf_version"
      ],
      "title": "ProfileReference",
      "type": "object"
    },
    "ReleaseFile": {
      "additionalProperties": false,
      "properties": {
        "acl_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acl Ref"
        },
        "canonical_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Sha256"
        },
        "classification": {
          "anyOf": [
            {
              "enum": [
                "PUBLIC",
                "INTERNAL",
                "CONFIDENTIAL",
                "RESTRICTED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classification"
        },
        "concept_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concept Type"
        },
        "concept_uid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concept Uid"
        },
        "criticality": {
          "anyOf": [
            {
              "enum": [
                "low",
                "moderate",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Criticality"
        },
        "exact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Exact Sha256",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "source_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Count"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "stale_after": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale After"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "draft",
                "stable",
                "deprecated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "verified_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified Count"
        }
      },
      "required": [
        "path",
        "size",
        "media_type",
        "exact_sha256"
      ],
      "title": "ReleaseFile",
      "type": "object"
    }
  },
  "$id": "https://schemas.verity-kf.example.invalid/okf/release-manifest-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ],
      "title": "Bundle Classification",
      "type": "string"
    },
    "bundle_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "consumer_contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Consumer Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ReleaseFile"
      },
      "title": "Files",
      "type": "array"
    },
    "media_type": {
      "const": "application/vnd.verity.kf.manifest.v1+json",
      "default": "application/vnd.verity.kf.manifest.v1+json",
      "title": "Media Type",
      "type": "string"
    },
    "prior_release_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prior Release Digest"
    },
    "profile": {
      "$ref": "#/$defs/ProfileReference"
    },
    "release_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{7,64}$",
      "title": "Source Commit",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "release_id",
    "created_at",
    "source_commit",
    "profile",
    "bundle_classification",
    "files"
  ],
  "title": "ReleaseManifest",
  "type": "object"
}
